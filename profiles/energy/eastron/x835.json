      "data_type": "float32",
      "measurement_type": "current_neutral",
      "unit": "A",
      "description": "Neutral current (30225)",
      "deadband": 0.2
    },
    {
      "reg": 234,
      "data_type": "float32",
      "measurement_type": "thd_voltage_l1",
      "unit": "%",
