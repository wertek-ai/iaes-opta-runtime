      "severity": "high"
    },
    {
      "reg": 236,
      "data_type": "float32",
      "measurement_type": "thd_voltage_l2",
      "unit": "%",
      "description": "Phase 2 L/N voltage THD (30237)",
      "deadband": 0.5
    },
    {
      "reg": 238,
      "data_type": "float32",
      "measurement_type": "thd_voltage_l3",
      "unit": "%",
      "description": "Phase 3 L/N voltage THD (30239)",
      "deadband": 0.5
    },
    {
      "reg": 240,
      "data_type": "float32",
      "measurement_type": "thd_current_l1",
      "unit": "%",
      "description": "Phase 1 current THD (30241)",
      "deadband": 0.5,
      "threshold_high": 20.0,
      "severity": "medium"
    },
    {
      "reg": 242,
      "data_type": "float32",
      "measurement_type": "thd_current_l2",
      "unit": "%",
