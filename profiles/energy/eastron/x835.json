{
  "device": "Eastron SMART X835 Energy Meter",
  "manufacturer": "Eastron",
  "category": "energy_meter",
  "protocol": "modbus_rtu",
  "baud_rate": 9600,
  "byte_order": "big_endian",
  "default_function": "input_registers",
  "notes": "Eastron SMART X835 three-phase energy meter. ALL registers use FC04 (input registers). All values are IEEE 754 float32 (2 registers each). Wire address = 3X register - 30001. Compatible with SDM630, SDM72D, and other Eastron meters sharing the same protocol. Max 40 parameters per request.",
  "registers": [
    {
      "reg": 0,
      "data_type": "float32",
      "measurement_type": "voltage_l1",
      "unit": "V",
      "description": "Phase 1 line to neutral voltage (30001)",
      "deadband": 2
    },
    {
      "reg": 2,
      "data_type": "float32",
      "measurement_type": "voltage_l2",
      "unit": "V",
      "description": "Phase 2 line to neutral voltage (30003)",
      "deadband": 2
    },
    {
      "reg": 4,
      "data_type": "float32",
      "measurement_type": "voltage_l3",
      "unit": "V",
      "description": "Phase 3 line to neutral voltage (30005)",
      "deadband": 2
    },
    {
      "reg": 6,
      "data_type": "float32",
      "measurement_type": "current_l1",
      "unit": "A",
      "description": "Phase 1 current (30007)",
      "deadband": 0.5
    },
    {
      "reg": 8,
      "data_type": "float32",
      "measurement_type": "current_l2",
      "unit": "A",
      "description": "Phase 2 current (30009)",
      "deadband": 0.5
    },
    {
      "reg": 10,
      "data_type": "float32",
      "measurement_type": "current_l3",
      "unit": "A",
      "description": "Phase 3 current (30011)",
      "deadband": 0.5
    },
    {
      "reg": 12,
      "data_type": "float32",
      "measurement_type": "power_l1",
      "unit": "W",
      "description": "Phase 1 active power (30013)",
      "deadband": 50
    },
    {
      "reg": 30,
      "data_type": "float32",
      "measurement_type": "power_factor_l1",
      "unit": "ratio",
      "description": "Phase 1 power factor (30031)",
      "deadband": 0.01
    },
    {
      "reg": 32,
      "data_type": "float32",
      "measurement_type": "power_factor_l2",
      "unit": "ratio",
      "description": "Phase 2 power factor (30033)",
      "deadband": 0.01
    },
    {
      "reg": 34,
      "data_type": "float32",
      "measurement_type": "power_factor_l3",
      "unit": "ratio",
      "description": "Phase 3 power factor (30035)",
      "deadband": 0.01
    },
    {
      "reg": 52,
      "data_type": "float32",
      "measurement_type": "power",
      "unit": "W",
      "description": "Total system active power (30053)",
      "deadband": 100
    },
    {
      "reg": 56,
      "data_type": "float32",
      "measurement_type": "apparent_power",
      "unit": "VA",
      "description": "Total system apparent power (30057)",
      "deadband": 100
    },
    {
      "reg": 60,
      "data_type": "float32",
      "measurement_type": "reactive_power",
      "unit": "VAR",
      "description": "Total system reactive power (30061)",
      "deadband": 100
    },
    {
      "reg": 62,
      "data_type": "float32",
      "measurement_type": "power_factor",
      "unit": "ratio",
      "description": "Total system power factor (30063)",
      "deadband": 0.01,
      "threshold_low": 0.90,
      "severity": "high"
    },
    {
      "reg": 70,
      "data_type": "float32",
      "measurement_type": "frequency",
      "unit": "Hz",
      "description": "Supply frequency (30071)",
      "deadband": 0.05
    },
    {
      "reg": 72,
      "data_type": "float32",
      "measurement_type": "energy_import",
      "unit": "kWh",
      "description": "Import active energy since last reset (30073)",
      "deadband": 1
    },
    {
      "reg": 74,
      "data_type": "float32",
      "measurement_type": "energy_export",
      "unit": "kWh",
      "description": "Export active energy since last reset (30075)",
      "deadband": 1
    },
    {
      "reg": 76,
      "data_type": "float32",
      "measurement_type": "reactive_energy_import",
      "unit": "kVARh",
      "description": "Import reactive energy since last reset (30077)",
      "deadband": 1
    },
    {
      "reg": 200,
      "data_type": "float32",
      "measurement_type": "voltage_l12",
      "unit": "V",
      "description": "Line 1 to Line 2 voltage (30201)",
      "deadband": 2
    },
    {
      "reg": 202,
      "data_type": "float32",
      "measurement_type": "voltage_l23",
      "unit": "V",
      "description": "Line 2 to Line 3 voltage (30203)",
